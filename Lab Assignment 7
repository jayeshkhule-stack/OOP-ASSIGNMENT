
#include<iostream>
using namespace std;

class person
{
public:
    string name;
    int age;
    string contact;

    void sdisplay()
    {
        cout<<"Name:"<<name<<endl;
        cout<<"Age:"<<age<<endl;
        cout<<"Contact:"<<contact<<endl;
    }
};

class student:public person
{
public:
    int rollno;
    string branch;

    void cdisplay()
    {
        cout<<"Rollno:"<<rollno<<endl;
        cout<<"Branch:"<<branch<<endl;
    }
};

int main()
{
    student s1;
    s1.name="Jayesh";
    s1.age=18;
    s1.contact="6152637098";
    s1.rollno=74;
    s1.branch="SOAI AIML";

    s1.sdisplay();
    s1.cdisplay();

    return 0;
}
