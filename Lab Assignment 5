#include <iostream>
#include <string>
using namespace std;

class student
{
public:
    int rollno;
    string name;
    int marks;

    student(int rollno, string name, int marks)
    {
        this->rollno = rollno;
        this->name = name;
        this->marks = marks;
    }

    void display()
    {
        cout << "------- Student Details -------" << endl;
        cout << "Name: " << this->name << endl;
        cout << "Roll No: " << this->rollno << endl;
        cout << "Marks: " << this->marks << endl;
    }
};

int main()
{
    student s1(74, "Jayesh", 87);

    s1.display();

    return 0;
}